# Zmienne ustawiane w Netlify → Project configuration → Environment variables (NIGDY w repozytorium ani w public/config.js)
GEMINI_API_KEY=            # sekret – klucz Google AI Studio (Trener AI)
SUPABASE_URL=              # publiczne – adres projektu Supabase (do sprawdzania zalogowania w funkcji AI)
SUPABASE_ANON_KEY=         # publiczne – klucz publishable/anon (NIE service_role)
# opcjonalnie
GEMINI_MODEL=
ANTHROPIC_API_KEY=         # sekret – tylko jeśli AI_PROVIDER=claude
AI_PROVIDER=
AI_MODEL=
